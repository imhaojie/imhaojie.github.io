---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Entry from "@components/Entry.astro";
import { education, honors } from "@data/profile";
import { experience } from "@data/experience";
import { news } from "@data/news";
import { publicationGroups } from "@data/publications";
import { projects } from "@data/projects";
---

<BaseLayout>
  <Hero />

  <div class="wrap">
    <section class="section split" id="experience" aria-labelledby="experience-title">
      <h2 id="experience-title">Research<br class="wide-only" /> experience</h2>
      <div class="positions">
        {experience.map((job) => (
          <article class="position">
            <div class="position__head">
              <h3>{job.institution}</h3>
              <span class="date">{job.period}</span>
            </div>
            <p class="position__team">{job.team}</p>
            <p class="position__role">{job.role}</p>
            <p>{job.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="publications" aria-labelledby="research-title">
      <h2 id="research-title">Publications &amp; preprints</h2>
      <div class="papers">
        {publicationGroups.flatMap((group) => group.entries).map((paper) => <Entry {...paper} />)}
      </div>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <h2 id="projects-title">Selected projects</h2>
      <div class="projects">
        {projects.map((project) => (
          <article class="project">
            {project.image && <a class="project__media" href={project.image.src} aria-label={`View full-size image for ${project.title}`}>
              <img src={project.image.thumb ?? project.image.src} alt={project.image.alt} width="528" height="290" loading="lazy" />
            </a>}
            <p class="kicker">{project.period} · {project.role} · {project.status}</p>
            <h3><a href={project.repo}>{project.title}</a></h3>
            <p>{project.summary}</p>
            <div class="text-links"><a href={project.repo}>Source code<span class="sr-only"> for {project.title}</span></a>
              {project.links?.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section split" id="education" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      <div class="education-list">
        {education.map((entry) => <article class="edu">
          <p class="date">{entry.period}</p>
          <h3><a href={entry.institutionUrl}>{entry.institution}</a></h3>
          <p class="position__role">{entry.degree}</p><p>{entry.detail}</p>
        </article>)}
      </div>
    </section>

    <section class="section split" id="honors" aria-labelledby="honors-title">
      <h2 id="honors-title">Honors &amp;<br class="wide-only" /> awards</h2>
      <ul class="honors">
        {honors.map((honor) => <li><div><strong>{honor.title}</strong><span>{honor.org}</span></div><span class="date">{honor.year}</span></li>)}
      </ul>
    </section>

    <section class="section split" id="news" aria-labelledby="news-title">
      <h2 id="news-title">News</h2>
      <div class="news">
        {news.slice(0, 2).map((item) => <p><span class="date">{item.date}</span><span><a href={item.href}>{item.highlight}</a> {item.body}</span></p>)}
        <details><summary>Earlier news</summary>
          {news.slice(2).map((item) => <p><span class="date">{item.date}</span><span><a href={item.href}>{item.highlight}</a> {item.body}</span></p>)}
        </details>
      </div>
    </section>
  </div>
</BaseLayout>
