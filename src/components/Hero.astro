---
import { site } from "@data/site";
import Icon from "@components/Icon.astro";
const [tongji, sjtu, sii] = site.affiliations;
---

<section id="about" class="hero" aria-labelledby="profile-name">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow"><span aria-hidden="true"></span>Multimodal AI <b aria-hidden="true">/</b> {site.location}</p>
      <h1 id="profile-name">{site.name} <span lang="zh-Hans">{site.nameCn}</span></h1>
      <p class="hero__lead">I study how video models connect <em>sound, motion, and memory.</em></p>
      <p class="hero__bio">I’m a research intern at <a href="#experience">Tencent Video</a> and a software engineering undergraduate at <a href={tongji.url}>{tongji.name}</a>. I’ll join <a href={sjtu.url}>{sjtu.name}</a> for a Ph.D. with joint training at <a href={sii.url}>{sii.name}</a>.</p>
      <div class="hero__links">
        <a class="primary-link" href="#publications">Explore my research</a>
        <a href={site.links.github} rel="me"><Icon name="github" /> GitHub</a>
        <a href={site.links.email}><Icon name="mail" /> Email</a>
      </div>
    </div>
    <div class="portrait">
      <div class="film"><img src={site.portrait} alt="Haojie Hu" width="700" height="700" fetchpriority="high" /></div>
    </div>
  </div>
</section>
