---
import type { Publication } from "@data/publications";
import { site } from "@data/site";
type Props = Publication;
const { title, href, authors, venue, summary, links, image } = Astro.props;
---
<article class="paper">
  {image && <a class="paper__figure" href={image.src} aria-label={`View full-size figure for ${title}`}>
    <img src={image.thumb ?? image.src} alt={image.alt} width="528" height="300" loading="lazy" />
  </a>}
  <div class="paper__body">
    <p class="kicker">{venue}</p>
    <h3>{href ? <a href={href}>{title}</a> : title}</h3>
    {authors && <p class="authors">{authors.map((author, index) => (
      <>{index > 0 && ", "}{author === site.name ? <strong>{author}</strong> : author}</>
    ))}</p>}
    <p>{summary}</p>
    {links && <div class="text-links">{links.map((link) => <a href={link.href}>{link.label}</a>)}</div>}
  </div>
</article>
